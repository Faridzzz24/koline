{
    "version": 2,
    "buildCommand": "echo 'Build complete'",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "includeFiles": ["database/**", "public/**"]
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:UO7Dsorfnsg+OTiz9UzA3BiScuIw3PDqlalv7IejGvE=",
        "APP_URL": "https://koline.vercel.app",
        "DB_CONNECTION": "sqlite",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr"
    }
}
